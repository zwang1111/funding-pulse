PORT=8787

# Optional x402 paywall (required for real bounty submission).
# When ADDRESS (or PAY_TO) is set and X402_ENABLED is not 0, createAgentApp
# wraps POST /entrypoints/funding-pulse/invoke with x402-hono.
# Unpaid requests return HTTP 402 with accepts[] + x402Version.
#
# Local free / bypass: leave ADDRESS unset, or set X402_ENABLED=0
# Local stub 402 (no facilitator): X402_STUB=1 + ADDRESS; bypass with
#   header X-PAYMENT-BYPASS: 1
#
# ADDRESS=0xYourEvmPayTo
# PAY_TO=0xYourEvmPayTo
# NETWORK=base
# FACILITATOR_URL=https://facilitator.daydreams.systems
# DEFAULT_PRICE=0.01
# X402_ENABLED=1
# X402_STUB=0
